        </connector>
        <!-- DARDENEXED-6: original UTM-null trigger condition ANDed with the Automation_Bypass__c
             check. Only ever set inside Apex test context; real transactions are unaffected. -->
        <filterFormula>AND(
    OR(
        ISNULL({!$Record.utm_content__c}),
        ISNULL({!$Record.utm_campaign__c}),
        ISNULL({!$Record.utm_medium__c}),
        ISNULL({!$Record.utm_source__c})
