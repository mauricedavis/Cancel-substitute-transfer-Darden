    <description>10/15/2024: &lt;MJD&gt; Added check to ensure that &apos;Page URL&apos; is not populated. Also, added check for &apos;Full FA URL&apos; for a question mark (?), as that would indicate UTM parameters to follow. 07/26/2026: &lt;MJD&gt; Added bypass check against Automation_Bypass__c custom setting for use by Apex tests (DARDENEXED-6).</description>
    <environments>Default</environments>
    <formulas>
        <name>var_UTMCampaign</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!$Record.Full_FA_URL__c}, &quot;utm_campaign=&quot;),
    MID( 
        {!$Record.Full_FA_URL__c},
        FIND(&quot;utm_campaign=&quot;, {!$Record.Full_FA_URL__c}) + 13,
        IF(
            FIND(&quot;&amp;&quot;, {!$Record.Full_FA_URL__c}, FIND(&quot;utm_campaign=&quot;, {!$Record.Full_FA_URL__c}) + 13) &gt; 0,
            FIND(&quot;&amp;&quot;, {!$Record.Full_FA_URL__c}, FIND(&quot;utm_campaign=&quot;, {!$Record.Full_FA_URL__c}) + 13) - FIND(&quot;utm_campaign=&quot;, {!$Record.Full_FA_URL__c}) - 13,
            LEN({!$Record.Full_FA_URL__c}) - FIND(&quot;utm_campaign=&quot;, {!$Record.Full_FA_URL__c}) - 12
        )
    ),
    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
